Table clientes {
  id int [pk, not null, increment]
  nombre varchar(4100) [not null]
  email varchar(100) [not null, unique]
}

Table pedidos {
  id int [pk, not null, increment]
  fecha date [not null]
  total decimal(10,2) [not null]
  cliente_id int [not null]
}

Ref: pedidos.cliente_id > clientes.id