Table dueno {
  id bigint [pk, increment]
  nombre varchar [not null]
  apellido varchar [not null]
  documento varchar [unique, not null]
  telefono varchar [not null]
  email varchar [not null]
  direccion varchar [not null]
}

Table mascota {
  id bigint [pk, increment]
  nombre varchar [not null]
  especie varchar [not null]
  raza varchar
  genero varchar [not null]
  fecha_nacimiento date
  alergias text
  notas_comportamiento text
  dueno_id bigint [not null, ref: > dueno.id]
}

Table inyeccion {
  id bigint [pk, increment]
  nombre varchar [not null]
  descripcion text
}

Table mascota_inyeccion {
  id bigint [pk, increment]
  mascota_id bigint [not null, ref: > mascota.id]
  inyeccion_id bigint [not null, ref: > inyeccion.id]
  fecha_aplicacion date [not null]
  proxima_fecha date
  notas text
}

Table cita {
  id bigint [pk, increment]
  mascota_id bigint [not null, ref: > mascota.id]
  fecha_cita datetime [not null]
  estado varchar [not null] // agendada, atendida, cancelada
  motivo varchar
}

Table visita {
  id bigint [pk, increment]
  cita_id bigint [not null, ref: > cita.id]
  procedimientos text
  cuidados_post text
  recomendaciones text
  observaciones text
  fecha_atencion datetime [not null]
}
