Table proveedor {
  id bigint [pk, not null, increment]
  nombre varchar [not null]
  nit varchar [unique, not null]
  telefono varchar [not null]
  email varchar
  direccion varchar
}

Table producto {
  id bigint [pk, increment]
  nombre varchar [not null]
  descripcion text
  proveedor_id bigint [not null, ref: > proveedor.id]
  precio_costo decimal [not null]
  precio_venta decimal [not null]
  stock int [not null]
}

Table cliente {
  id bigint [pk, increment]
  nombre varchar [not null]
  apellido varchar [not null]
  documento varchar [unique, not null]
  telefono varchar [not null]
  email varchar
}

Table venta {
  id bigint [pk, increment]
  cliente_id bigint [not null, ref: > cliente.id]
  fecha datetime [not null]
  total decimal [not null]
  metodo_pago varchar [not null]
}

Table detalle_venta {
  id bigint [pk, increment]
  venta_id bigint [not null, ref: > venta.id]
  producto_id bigint [not null, ref: > producto.id]
  cantidad int [not null]
  precio_unitario decimal [not null]
  subtotal decimal [not null]
}
