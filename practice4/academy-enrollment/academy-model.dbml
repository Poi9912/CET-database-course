Table periodos {
  id bigint [pk, increment]
  nombre varchar [not null]
  anio int [not null]
  fecha_inicio date [not null]
  fecha_fin date [not null]
}

Enum tipos_documentos {
  cedula_de_ciudadania
  cedula_de_extranjeria
  pasaporte
  tarjeta_de_identidad
  permiso_proteccion_temporal
}

Table maestros {
  id bigint [pk, increment]
  primer_nombre varchar [not null]
  segundo_nombre varchar
  primer_apellido varchar [not null]
  segundo_apellido varchar
  tipodocumento tipos_documentos [not null, default: "cedula_de_ciudadania"]
  documento varchar [unique, not null]
  email varchar [unique, not null]
  telefono varchar [unique, not null]
}

Table maestros_categorias {
  maestro_id bigint [not null, ref: > maestros.id]
  categoria_id bigint [not null, ref: > categorias.id]

  indexes {
    (maestro_id, categoria_id) [pk]
  }
}

Table categorias {
  id bigint [pk, increment]
  nombre varchar [not null, unique]
}

Table estudiante {
  id bigint [pk, increment]
  primer_nombre varchar [not null]
  segundo_nombre varchar
  primer_apellido varchar [not null]
  segundo_apellido varchar
  documento varchar [unique, not null]
  email varchar [unique, not null]
  telefono varchar [not null]
  fecha_nacimiento date [not null]
}

Table programa {
  id bigint [pk, increment]
  codigo varchar [unique, not null]
  categoria bigint [not null, ref: > categorias.id]
  nombre varchar [not null]
  descripcion text
  maestro_id bigint [not null, ref: > maestros.id]
}

Enum estado_inscripcion {
  creada
  reservada
  pendiente_por_pago
  aprobada
  activa
  retirada
}

Table inscripcion {
  id bigint [pk, increment]
  estudiante_id bigint [not null, ref: > estudiante.id]
  programa_id bigint [not null, ref: > programa.id]
  periodo_id bigint [not null, ref: > periodos.id]
  fecha_inscripcion date [not null]
  estado estado_inscripcion [not null, default: "creada"]
}